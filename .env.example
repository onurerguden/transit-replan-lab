# Model backend: replay (offline, default) or ollama.
TRL_MODEL=replay
TRL_PORT=8080
OLLAMA_BASE_URL=http://host.docker.internal:11434
TRL_OLLAMA_MODEL=qwen3.5:4b-q4_K_M
# Optional separate Operator model tag, for example a fused adapter.
TRL_OPERATOR_MODEL=
# SQLite database and data directory. Defaults resolve inside the checkout.
TRL_DB=
TRL_DATA=
# OTLP/HTTP endpoint for traces, for example http://127.0.0.1:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
